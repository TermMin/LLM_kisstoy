# Paste a newly generated remote-control URL. Never commit a real URL.
KISSTOY_REMOTE_URL="https://api.app.knightjenay.cn/kisstoy/remote/#/?device_id=18&group=REPLACE_ME&id=REPLACE_ME&lang=zh"

# Safe defaults: physical control is disabled until this is explicitly true.
KISSTOY_LIVE_CONTROL=false
KISSTOY_MAX_INTENSITY=100
KISSTOY_MAX_DURATION_MS=300000
KISSTOY_ARM_TTL_SECONDS=3600
KISSTOY_MAX_COMMANDS_PER_MINUTE=20

# HTTP transport. Keep localhost for local/tunnel-based development.
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ALLOWED_HOSTS=*.trycloudflare.com

# Required when live control is exposed on a non-loopback HTTP interface.
# MCP_BEARER_TOKEN=replace-with-a-long-random-value
